# socrate-admin-bff configuration
#
# Local development: copy to bff/.env (ignored by git), then set BFF_CLIENT_SECRET,
# BFF_OAUTH_PUBLIC_URL=http://localhost:8080, BFF_PUBLIC_ORIGIN=http://localhost:5173
# and BFF_COOKIE_SECURE=false. The BFF reads the environment only; load the file with
#   set -a && . ./.env && set +a
# The server copy lives in /etc/socrate/admin-bff.env (see deploy/env/).
#
# The BFF refuses to start without a confidential client (BFF_CLIENT_ID) unless
# BFF_PHASE1_PASSTHROUGH=true is set explicitly; that mode is an unauthenticated
# pass-through to the admin API and exists only for a migration window.

# ── Listener / upstream ──────────────────────────────────────────────────────
BFF_LISTEN_ADDR=127.0.0.1:8091
BFF_ADMIN_UPSTREAM=http://127.0.0.1:8081

# ── Confidential client and server-side sessions (REQUIRED) ─────────────────
# The client_id/secret are a CONFIDENTIAL OAuth client held only by the BFF —
# never in the SPA.
BFF_CLIENT_ID=admin-console
BFF_CLIENT_SECRET=CHANGE_ME
BFF_OAUTH_UPSTREAM=http://127.0.0.1:8080
BFF_OAUTH_PUBLIC_URL=https://socrate.vandermoten.eu
BFF_PUBLIC_ORIGIN=https://admin.vandermoten.eu
# Quote this value if you source the file from a shell: BFF_SCOPES="openid profile email"
BFF_SCOPES=openid profile email
BFF_SESSION_IDLE=30m
BFF_SESSION_ABSOLUTE=8h
# Only set to false together with an http:// BFF_PUBLIC_ORIGIN (local dev).
BFF_COOKIE_SECURE=true
# Per-IP budgets per minute: /bff/login, /bff/elevate, and the two public
# password-reset posts the BFF forwards to the issuer (they trigger email).
BFF_LOGIN_RATE=10
BFF_ELEVATE_RATE=5
BFF_PASSWORD_RESET_RATE=5

# ── Migration-only escape hatches (logged as WARNINGs at startup) ────────────
# BFF_PHASE1_PASSTHROUGH=true   # run with no sessions at all (BFF_CLIENT_ID unset)
# BFF_ALLOW_PASSTHROUGH=true    # forward session-less requests with their own bearer
