# /etc/socrate/admin-bff.env  (mode 0640, root:socrate-admin-bff — readable only
# by root and the admin BFF's own service user; secrets live ONLY here)
#
# The BFF refuses to start without server-side sessions (Phase 2) unless
# BFF_PHASE1_PASSTHROUGH=true is set explicitly. Phase 1 is an unauthenticated
# pass-through to the loopback-only admin API — never run it in production.

# ── Listener / upstream ──────────────────────────────────────────────────────
BFF_LISTEN_ADDR=127.0.0.1:8091
BFF_ADMIN_UPSTREAM=http://127.0.0.1:8081

# ── Phase 2: server-side sessions (REQUIRED) ─────────────────────────────────
# A CONFIDENTIAL OAuth client registered in Socrate: client_id + secret are
# held ONLY by the BFF, never by the SPA. Fill both before starting.
BFF_CLIENT_ID=admin-console
BFF_CLIENT_SECRET=CHANGE_ME
BFF_OAUTH_UPSTREAM=http://127.0.0.1:8080
BFF_OAUTH_PUBLIC_URL=https://socrate.vandermoten.eu
BFF_PUBLIC_ORIGIN=https://admin.vandermoten.eu
BFF_SCOPES=openid profile email
BFF_SESSION_IDLE=30m
BFF_SESSION_ABSOLUTE=8h
# Must stay true on an https origin (the BFF refuses false there).
BFF_COOKIE_SECURE=true
# Per-IP budgets per minute: /bff/login, /bff/elevate, and the two public
# password-reset posts the BFF forwards to the issuer (they trigger email).
BFF_LOGIN_RATE=10
BFF_ELEVATE_RATE=5
BFF_PASSWORD_RESET_RATE=5

# ── Migration-only escape hatches (both are logged as WARNINGs at startup) ───
# Run without sessions at all (Phase 1 pass-through). Requires BFF_CLIENT_ID
# to be unset. Do not use in production.
# BFF_PHASE1_PASSTHROUGH=true
# With Phase 2 on, forward session-less requests with the browser's own
# Authorization header instead of rejecting them with 401.
# BFF_ALLOW_PASSTHROUGH=true
