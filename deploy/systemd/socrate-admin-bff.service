[Unit]
Description=Socrate Admin Console BFF
Documentation=https://github.com/ovander/oauth2-admin/tree/main/bff
After=network-online.target socrate.service
Wants=network-online.target

[Service]
Type=simple
# P4-1: the BFF is the internet-facing parser and must not share an identity
# with the identity server. Its own user cannot read Socrate's signing keys,
# Socrate's env (SECRET_KEY_BASE, DATABASE_URL) or the monitoring BFF's secrets.
User=socrate-admin-bff
Group=socrate-admin-bff
EnvironmentFile=/etc/socrate/admin-bff.env
ExecStart=/usr/local/bin/socrate-admin-bff
Restart=on-failure
RestartSec=2

# ── Hardening ────────────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
# Belt and braces on top of the dedicated user: even if the user split is
# undone by hand, these paths do not exist inside this unit's mount namespace.
InaccessiblePaths=-/var/lib/socrate -/etc/socrate/socrate.env -/etc/socrate/bff.env

[Install]
WantedBy=multi-user.target
