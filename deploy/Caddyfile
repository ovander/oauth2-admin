# Socrate admin console — Caddy site block for admin.vandermoten.eu
#
# Caddy is the only public listener. It serves the built SPA and routes the BFF
# + admin-API paths to the internal admin BFF (127.0.0.1:8091), which is the only
# client of the loopback admin API. Import this from your main Caddyfile, e.g.:
#     import /etc/caddy/sites/*.caddy

admin.vandermoten.eu {
	root * /srv/admin/dist

	header {
		# HSTS + sniffing/clickjacking defenses
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		# Non-CSP hardening headers — mirror SECURITY_HEADERS in src/security/csp.ts.
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Cross-Origin-Opener-Policy "same-origin"
		# CSP — exactly productionCsp() from src/security/csp.ts (the canonical,
		# unit-tested policy; csp.spec.ts fails if this line drifts from it).
		# Same-origin app: the BFF makes every call first-party.
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
		# Trusted Types, staged (docs/security-headers.md): exactly
		# REPORTING_ENDPOINTS and productionCspReportOnly() from csp.ts (csp.spec.ts
		# checks both). Violations are only reported, to POST /bff/csp-report on
		# the admin BFF (routed by @bff below), which logs them.
		Reporting-Endpoints `csp="/bff/csp-report"`
		Content-Security-Policy-Report-Only "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; require-trusted-types-for 'script'; trusted-types vue default; report-uri /bff/csp-report; report-to csp"
		# Don't advertise the server
		-Server
	}

	# BFF endpoints + admin API (/api/admin/* and the app-scoped /api/apps/*,
	# both on the admin listener) + allowlisted issuer routes → internal admin
	# BFF (the ONLY client of the admin API). The BFF injects the bearer server-side
	# and allowlists the issuer paths one by one: /api/profile and the
	# /api/profile/mfa routes (session-auth self-service), /api/version (public
	# probe) and the two public
	# password-reset posts (P3-23). /bff/* includes POST /bff/csp-report, the
	# CSP report endpoint. flush_interval -1 keeps SSE unbuffered.
	#
	# Trust model (P3-17): the BFF honours X-Forwarded-For only from a loopback
	# peer, relying on Caddy's default trusted_proxies (none) to REPLACE any
	# client-supplied X-Forwarded-For with the real peer address. Do not add
	# `trusted_proxies` here unless a further proxy sits in front of Caddy.
	@bff path /bff/* /api/admin/* /api/apps/* /api/profile /api/profile/mfa /api/profile/mfa/* /api/version /api/auth/request-password-reset /api/auth/reset-password
	handle @bff {
		reverse_proxy 127.0.0.1:8091 {
			flush_interval -1
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Everything else → the built SPA (history-API fallback).
	# NOTE: once the SPA is cookie-only there is no direct browser→admin-API
	# route — all admin traffic flows through @bff above.
	handle {
		try_files {path} /index.html
		file_server
	}
}
