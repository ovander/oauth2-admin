# Socrate admin console — Caddy site block for admin.vandermoten.eu
#
# Caddy is the only public listener. It serves the built SPA and routes the BFF
# + admin-API paths to the internal admin BFF (127.0.0.1:8091), which is the only
# client of the loopback admin API. Import this from your main Caddyfile, e.g.:
#     import /etc/caddy/sites/*.caddy

admin.vandermoten.eu {
	root * /srv/admin/dist

	header {
		# HSTS + sniffing/clickjacking defenses
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		# Non-CSP hardening headers — mirror SECURITY_HEADERS in src/security/csp.ts.
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Cross-Origin-Opener-Policy "same-origin"
		# CSP — same-origin app (the BFF makes it all first-party). Mirrors the
		# repo's canonical policy (src/security/csp.ts), relaxed to default-src
		# 'self' for the cookie/BFF model.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		# Don't advertise the server
		-Server
	}

	# BFF endpoints + admin API + allowlisted issuer routes → internal admin BFF
	# (the ONLY client of the admin API). The BFF injects the bearer server-side
	# and allowlists the issuer paths one by one: /api/profile (session-auth
	# self-service), /api/version (public probe) and the two public
	# password-reset posts (P3-23). flush_interval -1 keeps SSE unbuffered.
	#
	# Trust model (P3-17): the BFF honours X-Forwarded-For only from a loopback
	# peer, relying on Caddy's default trusted_proxies (none) to REPLACE any
	# client-supplied X-Forwarded-For with the real peer address. Do not add
	# `trusted_proxies` here unless a further proxy sits in front of Caddy.
	@bff path /bff/* /api/admin/* /api/profile /api/version /api/auth/request-password-reset /api/auth/reset-password
	handle @bff {
		reverse_proxy 127.0.0.1:8091 {
			flush_interval -1
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Everything else → the built SPA (history-API fallback).
	# NOTE: once the SPA is cookie-only there is no direct browser→admin-API
	# route — all admin traffic flows through @bff above.
	handle {
		try_files {path} /index.html
		file_server
	}
}
